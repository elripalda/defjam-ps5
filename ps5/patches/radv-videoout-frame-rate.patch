 static once_flag videoout_once = ONCE_FLAG_INIT;
+/* The application's say over 119.88 Hz (wsi_videoout_want_high_frame_rate):
+ * -1 leaves it to the title's metadata, 0 keeps 59.94 Hz, 1 asks for 119.88. */
+static int videoout_hfr_wanted = -1;
 
 static void
 videoout_output_init_once(void)
